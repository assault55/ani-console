# 使用方式
# - 开发环境：复制为 .env.development
# - 生产构建：复制为 .env.production
# - 通用配置放 .env（可选）

# ---- development ----
# 本地开发（可选）：`npm run dev` 时把浏览器 /api/v1 请求代理到后端
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
# 开发回调地址（与认证服务登记一致）
VITE_OIDC_REDIRECT_URI=http://localhost:5173/login/callback
# Gateway ANI_AUTH_MODE=dev 时可跳过前端登录（仅本地联调，勿用于生产）
# VITE_DEV_AUTH_BYPASS=true

# ---- production ----
# 生产不走 Vite dev proxy，/api 由部署侧网关/反向代理处理
# 生产回调地址（必须与 Dex/认证服务登记一致）
# VITE_OIDC_REDIRECT_URI=http://ani-console.ani-system.svc.cluster.local/login/callback
